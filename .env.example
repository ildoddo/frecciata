# --- Database -------------------------------------------------------------
# Locale: PostgreSQL qualsiasi (es. docker-compose.yml incluso: porta 5432).
# Vercel: usa l'URL di Vercel Postgres (Neon) — per la preview/serverless
# conviene il pooler:
#   postgres://USER:PASS@ep-xxx-pooler.eu-central-1.aws.neon.tech/app?pgbouncer=true&connection_limit=1
DATABASE_URL="postgres://postgres:postgres@localhost:5432/frecciata"

# --- Autenticazione --------------------------------------------------------
# Genera con: openssl rand -base64 32
AUTH_SECRET="cambiame-copia-genera-un-segreto-lungo"

# --- Club -------------------------------------------------------------------
# Fuso orario usato per giorni solari, ricorrenze e vincolo "un turno al giorno"
# (i due valori devono coincidere)
CLUB_TIMEZONE="Europe/Rome"
NEXT_PUBLIC_CLUB_TIMEZONE="Europe/Rome"

# Solo per il seed (npm run db:seed): crea un utente ADMIN
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@club.local"
ADMIN_PASSWORD="admin1234"
